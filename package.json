{
  "name": "magpie-mcp",
  "version": "0.9.3",
  "description": "Your loyal Magpie lands every visual in the nest. Local library for HTML mockups, Mermaid, SVG, Markdown, Graphviz, Vega-Lite, D2, and any non-code artifact your AI agent authors (Claude, Cursor, Cline). Pairs with any MCP host. Organize, version, compare — never generate.",
  "license": "MIT",
  "author": "Omer BarOr <omerb784@gmail.com>",
  "homepage": "https://github.com/omerb784/magpie-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omerb784/magpie-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/omerb784/magpie-mcp/issues"
  },
  "keywords": [
    "mcp",
    "claude",
    "visual",
    "dashboard",
    "mockup",
    "mermaid",
    "svg",
    "markdown",
    "graphviz",
    "dot",
    "vega-lite",
    "d2",
    "chart",
    "magpie"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "magpie-mcp": "dist/index.js",
    "magpie": "dist/cli.js"
  },
  "files": [
    "dist",
    "skill/magpie-master",
    "seed",
    "scripts/preinstall-check.mjs",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "preinstall": "node scripts/preinstall-check.mjs",
    "dev": "concurrently -n srv,ui -c blue,magenta \"tsx --env-file=.env.dev watch src/index.ts\" \"npm run dev:ui\"",
    "dev:ui": "vite ui --port 5273",
    "build": "npm run clean && npm run build:server && npm run build:ui && npm run build:island && npm run build:island-templates",
    "clean": "node scripts/clean-dist.mjs",
    "build:server": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "build:ui": "vite build ui --outDir ../dist/ui",
    "build:island": "vite build ui --config ui/vite.island.config.ts",
    "build:island-templates": "node scripts/build-island-templates.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:all": "npm run test && npm run test:e2e",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "brand:resize": "node scripts/brand-resize.mjs",
    "visual:pdf": "node scripts/visual-to-pdf.mjs",
    "check:tarball": "node scripts/check-tarball.mjs",
    "audit:postinstall": "node scripts/audit-postinstall.mjs",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "audit:mcp-cost": "node scripts/measure-mcp-token-cost.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "prepublishOnly": "npm run build && npm run test:all && npm run check:tarball && npm run audit:postinstall && npm run audit:deps && npm run sbom"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@hpcc-js/wasm-graphviz": "^1.21.5",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@terrastruct/d2": "^0.1.33",
    "@types/diff": "^7.0.2",
    "better-sqlite3": "^12.9.0",
    "diff": "^9.0.0",
    "fflate": "^0.8.2",
    "highlight.js": "^11.11.1",
    "hono": "^4.6.0",
    "isomorphic-dompurify": "^3.12.0",
    "marked": "^18.0.3",
    "marked-highlight": "^2.2.4",
    "mermaid": "^11.4.0",
    "nanoid": "^5.0.0",
    "puppeteer-core": "^23.0.0",
    "vega": "^6.2.0",
    "vega-lite": "^6.4.3",
    "ws": "^8.18.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^2.1.9",
    "concurrently": "^9.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "sharp": "^0.34.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
